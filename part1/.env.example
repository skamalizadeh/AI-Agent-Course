# ============================================================
# تنظیمات اتصال به مدل زبانی
# این فایل را با نام .env کپی کنید و مقادیر را پر کنید.
# فایل .env را هرگز در GitHub قرار ندهید.
# ============================================================

# ---- ارائه‌دهندهٔ فعال: همهٔ برنامه‌ها از این سه مقدار استفاده می‌کنند ----
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:3b

# (اختیاری، بخش دوم) مدل تعبیه برای جست‌وجوی معنایی در پروژهٔ ۲.
# در Ollama: ollama pull nomic-embed-text   — اگر خالی بماند، جست‌وجوی ساده بر اساس کلمه استفاده می‌شود.
LLM_EMBED_MODEL=

# ---- (اختیاری) ارائه‌دهنده‌های دیگر برای آزمون با check_setup.py ----
# هر بخشی که پر شود، check_setup.py آن را هم آزمایش می‌کند.
# برای عوض کردن ارائه‌دهندهٔ فعال، سه مقدار بالا را با مقادیر یکی از این بخش‌ها جایگزین کنید.

# مسیر اول: Ollama (محلی)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5:3b

# مسیر دوم: OpenRouter (شناسهٔ مدل را از صفحهٔ همان مدل در openrouter.ai کپی کنید)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# مسیر سوم: آروان‌کلاد (هر سه مقدار را از بخش هوش مصنوعی پنل آروان کپی کنید)
ARVAN_BASE_URL=
ARVAN_API_KEY=
ARVAN_MODEL=
